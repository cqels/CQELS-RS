<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Java counterpart of `parity-tests/runner-rust`. Consumes the same
    fixture format and drives each workload through a live cqels-java
    engine (https://github.com/cqels/claude — the same repo the Rust
    port has been tracking from the start), reporting binding output
    for diff against `expected.jsonl`.

    Authored against the public engine façade in cqels/claude:
    `org.cqels.engine.CQELSEngine` + `DataStream` + `QueryResultListener`.
    cqels-engine pulls cqels-core, cqels-storage-spi, cqels-shacl, and
    the RDF4J/Reactor stack transitively — no extra dependency wiring
    needed here.

    cqels/claude is private + not on Maven Central, so consumers must
    clone it and `mvn install -DskipTests` before this module will
    resolve. Internal forks with different coordinates can override
    `cqels.dependency.{groupId,artifactId,version}` from the command
    line.
  -->
  <groupId>cqels.parity</groupId>
  <artifactId>cqels-parity-runner-java</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>cqels-parity-runner-java</name>
  <description>
    Runs language-neutral cqels parity fixtures against the Java engine.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- cqels/claude requires JDK 17. -->
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>

    <!--
      Coordinates for the engine under test. Defaults match
      cqels/claude @ main. Override via
      `-Dcqels.dependency.{groupId,artifactId,version}=...` on the
      Maven command line for forks with different coordinates.
    -->
    <cqels.dependency.groupId>org.cqels</cqels.dependency.groupId>
    <cqels.dependency.artifactId>cqels-engine</cqels.dependency.artifactId>
    <cqels.dependency.version>2.0.0-SNAPSHOT</cqels.dependency.version>

    <jackson.version>2.17.0</jackson.version>
    <tomlj.version>1.1.1</tomlj.version>
    <jmh.version>1.37</jmh.version>
  </properties>

  <dependencies>
    <!--
      The cqels-java engine. cqels/claude is private + not on Maven
      Central — clone https://github.com/cqels/claude and `mvn install
      -DskipTests` first, or set the coordinates above to a fork that
      does publish.
    -->
    <dependency>
      <groupId>${cqels.dependency.groupId}</groupId>
      <artifactId>${cqels.dependency.artifactId}</artifactId>
      <version>${cqels.dependency.version}</version>
    </dependency>

    <!-- JSON: parsing streams.jsonl + expected.jsonl + rendering diff lines -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- TOML: parsing metadata.toml -->
    <dependency>
      <groupId>org.tomlj</groupId>
      <artifactId>tomlj</artifactId>
      <version>${tomlj.version}</version>
    </dependency>

    <!-- JMH: benchmark harness; only on the JMH executable path -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>${jmh.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <!-- `mvn package` produces a runnable jar that wraps the Runner. -->
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>cqels.parity.runner.Runner</mainClass>
            </manifest>
          </archive>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
        </configuration>
        <executions>
          <execution>
            <id>make-runnable-jar</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Build the JMH benchmark uber-jar alongside. Output:
        `target/parity-bench.jar`. Run with `java -jar target/parity-bench.jar`.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <id>bench-uber-jar</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>parity-bench</finalName>
              <transformers>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.openjdk.jmh.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
