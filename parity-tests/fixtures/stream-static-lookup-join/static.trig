# Static-graph data for the stream-static-lookup-join fixture.
# Three of the four sensors (s1, s2, s3) have a location; s4 has
# none — its temperature event should therefore be filtered out
# of the joined result (no matching static location row).
#
# Named-graph IRI matches the `FROM <http://ex.org/static/sensors>`
# clause in `query.cqels` so the engine routes the static-pattern
# match against this partition.
<http://ex.org/static/sensors> {
    <http://ex.org/s1> <http://ex.org/location> "kitchen" .
    <http://ex.org/s2> <http://ex.org/location> "lounge" .
    <http://ex.org/s3> <http://ex.org/location> "garage" .
}
