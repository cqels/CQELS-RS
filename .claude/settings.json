{
  "permissions": {
    "allow": [
      "Bash(~/.cargo/bin/cargo *)",
      "Bash(RUSTDOCFLAGS*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git stash*)",
      "Bash(git push *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(chmod *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git clean -fdx*)",
      "Bash(gh run watch *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/danhlephuoc/code/cqels-rs/.claude/hooks/auto-format.sh"
          }
        ]
      }
    ]
  }
}
